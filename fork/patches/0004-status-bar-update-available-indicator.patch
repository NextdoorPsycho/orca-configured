+/* Fork: bottom-bar update-available indicator — slow white/black crossfade
+   (3s per fade leg) so it registers without nagging. */
+.fork-update-pulse {
+  animation: fork-update-pulse 6s ease-in-out infinite;
+}
+@keyframes fork-update-pulse {
+  0%,
+  100% {
