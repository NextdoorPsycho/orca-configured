+
+/* Fork: bottom-bar update-available indicator — slow white/black crossfade
+   (3s per fade leg) so it registers without nagging. */
+.fork-update-pulse {
+  animation: fork-update-pulse 6s ease-in-out infinite;
+}
+@keyframes fork-update-pulse {
+  0%,
+  100% {
+    color: #ffffff;
+  }
+  50% {
+    color: #000000;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .fork-update-pulse {
+    animation: none;
+  }
+}
diff --git a/src/renderer/src/components/status-bar/UpdateStatusSegment.test.tsx b/src/renderer/src/components/status-bar/UpdateStatusSegment.test.tsx
